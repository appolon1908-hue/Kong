{
  "version": 1,
  "control_plane_status_context": "promotion-gate",
  "github_guard_context": "promotion-guard",
  "promotion_chain": [
    {
      "head": "subsection/<section>--<subsection>",
      "base": "section/<section>"
    },
    {
      "head": "section/*",
      "base": "development"
    },
    {
      "head": "development",
      "base": "testing"
    },
    {
      "head": "testing",
      "base": "staging"
    },
    {
      "head": "staging",
      "base": "production"
    }
  ],
  "bootstrap_exception": {
    "head": "governance/development-control-plane-v1",
    "base": "main"
  },
  "production_defaults": {
    "PRODUCTION_GO": "NO",
    "LIVE_CAPABILITIES_ENABLED": "NO",
    "EXTERNAL_EFFECTS": "false"
  }
}
